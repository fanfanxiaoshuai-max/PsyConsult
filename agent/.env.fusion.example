# Fusion clone setup; never commit your populated agent/.env.
# Copy to agent/.env, then enter your own China (Beijing) DashScope key.
DASHSCOPE_API_KEY=
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REDIS_URL=redis://localhost:6380
MILVUS_HOST=localhost
MILVUS_PORT=19531
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
API_AUTH_TOKEN=replace-with-your-professional-token
API_LOCAL_USER_ID=doctor_001
API_LOCAL_ROLE=admin
# Optional: bind separate credentials to user identities and roles; overrides the single local token.
# API_AUTH_USERS={"doctor_demo":{"token":"replace-with-reader-token","role":"reader"},"admin_demo":{"token":"replace-with-admin-token","role":"admin"}}
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
ENABLE_SEMANTIC_CACHE=true
ENABLE_LLM_GRAPH_CYPHER=false
